# ============================================================
# TN Politics Monitor — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values you need.
# At minimum, NEWS RSS works with NO keys at all.
# ============================================================

# --- Database ---
# DATABASE_URL=sqlite:///./tn_politics.db

# --- Collection ---
COLLECTION_ENABLED=true
COLLECTION_INTERVAL_SECONDS=120

# ============================================================
# FREE API KEYS — How to get them
# ============================================================

# --- YouTube Data API v3 (FREE — 10,000 units/day) ---
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (e.g. "TN Politics Monitor")
# 3. Go to APIs & Services → Library
# 4. Search "YouTube Data API v3" → Enable it
# 5. Go to APIs & Services → Credentials → Create Credentials → API Key
# 6. (Recommended) Restrict the key to YouTube Data API v3 only
# 7. Paste the key below
YOUTUBE_API_KEY=

# --- Reddit (FREE for non-commercial use) ---
# The app already works WITHOUT Reddit keys (uses public JSON).
# For higher rate limits (100 req/min instead of 10):
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create another app..."
# 3. Name: "tn-politics-monitor", Type: "script"
# 4. Redirect URI: http://localhost:8000
# 5. Copy the client_id (under the app name) and secret
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tn-politics-monitor/1.0

# --- GNews API (FREE — 100 requests/day, 10 articles each) ---
# 1. Go to https://gnews.io
# 2. Sign up for a free account
# 3. Copy your API key from the dashboard
GNEWS_API_KEY=

# --- X / Twitter (PAID — $100/month Basic tier) ---
# NOT FREE. Only set this if you have a paid X API subscription.
# 1. Go to https://developer.x.com
# 2. Subscribe to Basic tier ($100/month)
# 3. Create a project → Generate Bearer Token
# X_BEARER_TOKEN=

# --- Facebook / Instagram (placeholder, not implemented) ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_ACCESS_TOKEN=
